<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Samples & Logos rewrites
  RewriteRule ^api/?$ https://jfrpvijkfcsfewtljnah.supabase.co/functions/v1/api [P,L]
  RewriteRule ^api/(.*)$ https://jfrpvijkfcsfewtljnah.supabase.co/functions/v1/api/$1 [P,L]
  RewriteRule ^samples/(.*)$ images/samples/$1 [L]
  RewriteRule ^logos/(.*)$ images/logos/$1 [L]

  # Admin SPA routing
  RewriteRule ^admin(/.*)?$ admin.html [L]

  # App SPA routing
  RewriteRule ^app(/.*)?$ app.html [L]
</IfModule>
