# =====================================================================
#  উদ্যোক্তা গ্রাফিক্স AI — পরিবেশের ভ্যারিয়েবল কনফিগারেশন (.env.example)
# =====================================================================

# ---------------------------------------------------------------------
# ১. SUPABASE CONFIGURATION (সিস্টেম কোর ও ডাটাবেস) — [DEFAULT ACTIVE]
# ---------------------------------------------------------------------
# Supabase প্রজেক্ট সেটিংস (Settings -> API সেকশন থেকে পাবেন)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# PostgreSQL কানেকশন স্ট্রিং (PgBouncer Pooler - Port 6543)
DATABASE_URL=postgresql://postgres.your-project-id:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true


# ---------------------------------------------------------------------
# ২. সিকিউরিটি ও সেশন (Security, JWT & Auth) — [DEFAULT ACTIVE]
# ---------------------------------------------------------------------
# কাস্টমার লগইন সেশন টোকেন সাইন করার জন্য সিক্রেট কি (কমপক্ষে ৩২ অক্ষর)
JWT_SECRET=super-secret-random-jwt-key-min-32-chars-long

# সেশন মেয়াদ (দিনের সংখ্যা)
SESSION_EXPIRY_DAYS=30

# অ্যাডমিন প্যানেল পাসওয়ার্ড হ্যাশ (admin1234 এর ডিফল্ট হ্যাশ)
ADMIN_PASSWORD_HASH=ac9689e2272427085e35b9d3e3e8bed88cb3434828b43b86fc0596cad4c6e270


# ---------------------------------------------------------------------
# ৩. অ্যাপ্লিকেশন ডোমেইন ও CORS — [DEFAULT ACTIVE]
# ---------------------------------------------------------------------
LANDING_URL=https://yourclientdomain.com
ALLOWED_ORIGINS=https://app.yourclientdomain.com,https://yourclientdomain.com,http://localhost:3000,http://localhost:5500


# =====================================================================
#  নিচের ফিল্ডগুলো এখন সরাসরি অ্যাডমিন প্যানেল "সেটিংস" থেকে নিয়ন্ত্রিত হয়
#  (ডাটাবেসের 'settings' টেবিলে সেভ ও লাইভ টেস্ট করা যায়)
# =====================================================================

# ---------------------------------------------------------------------
# ৪. CLOUDINARY CONFIGURATION (অ্যাডমিন সেটিংস পেজ থেকে নিয়ন্ত্রিত)
# ---------------------------------------------------------------------
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz12345
# CLOUDINARY_FOLDER=uddokta_graphics_ai
# CLOUDINARY_UPLOAD_PRESET=uddokta_presets

# ---------------------------------------------------------------------
# ৫. EPS PAYMENT GATEWAY (অ্যাডমিন সেটিংস পেজ থেকে নিয়ন্ত্রিত)
# ---------------------------------------------------------------------
# EPS_MODE=sandbox
# EPS_MERCHANT_ID=your_merchant_id
# EPS_STORE_ID=your_store_id
# EPS_USERNAME=your_eps_username
# EPS_PASSWORD=your_eps_password
# EPS_HASH_KEY=your_eps_hash_key
# EPS_SANDBOX_URL=https://sandboxpgapi.eps.com.bd
# EPS_LIVE_URL=https://pgapi.eps.com.bd
# EPS_EMAIL=billing@uddoktagraphics.com

# ---------------------------------------------------------------------
# ৬. BULKSMSBD OTP GATEWAY (অ্যাডমিন সেটিংস পেজ থেকে নিয়ন্ত্রিত)
# ---------------------------------------------------------------------
# SMS_API_TOKEN=your_bulksmsbd_api_key
# SMS_SENDER_ID=your_approved_sender_id
# SMS_API_URL=https://bulksmsbd.net/api/smsapi

# ---------------------------------------------------------------------
# ৭. মেম্বারশিপ ও অ্যাপ URL (অ্যাডমিন সেটিংস পেজ থেকে নিয়ন্ত্রিত)
# ---------------------------------------------------------------------
# APP_URL=https://app.yourclientdomain.com
# ADMIN_PASSWORD=admin1234
